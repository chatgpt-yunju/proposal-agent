# ============ 应用 ============
APP_HOST=0.0.0.0
APP_PORT=8000

# ============ 数据库（SQLite：项目 / 章节元数据） ============
DB_PATH=./data/agent.db

# ============ 知识库向量存储 ============
# qdrant | numpy（qdrant-client 不可用时自动回退 numpy，保证离线可运行）
KB_VECTOR_BACKEND=qdrant
# qdrant local(嵌入式) 模式数据目录
KB_VECTOR_DIR=./data/vector_db
KB_COLLECTION=proposal_kb

# ============ 嵌入 ============
# api | local
#  api  ：OpenAI 兼容 /embeddings（推荐，质量最高）
#  local：numpy 字符 bigram 哈希向量（离线兜底，无需下载模型）
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_LOCAL_DIM=8192

# ============ 检索 ============
RETRIEVAL_TOP_K=6
# 三级作用域权重（轻度加成：相关性为主、具体优先为辅，仅相关度相当时打破次序）
SCOPE_WEIGHT_CHAPTER=1.2
SCOPE_WEIGHT_PROJECT=1.1
SCOPE_WEIGHT_GLOBAL=1.0
# 相关性门槛：低于此真实相关度的召回视为无关，不参与融合（相关性为主，作用域权重为辅）
RETRIEVAL_MIN_REL=0.10

# ---- 写作流 LLM（M3）----
# api：OpenAI 兼容 /chat/completions（可接豆包 / DeepSeek / 本地 vLLM 等），推荐
# local：离线兜底，将三级知识库检索引用结构化组装为章节正文（用于跑通工作流与测试）
LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 审查-修订循环上限
WORKFLOW_MAX_ITERATIONS=2
# 生成的完整方案输出目录
PROPOSAL_OUTPUT_DIR=./data/output
